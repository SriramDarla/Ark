# Google OAuth credentials — get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# GitHub OAuth credentials — https://github.com/settings/developers (callback: http://localhost:3001/api/auth/github/callback)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Session secret — any long random string
SESSION_SECRET=change-me-to-a-random-string

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
